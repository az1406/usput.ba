<%# Locals: plan, location, moments, public_moments, context.
    Optional: can_add (defaults to logged in — capture is gated on having been
    there wherever the caller knows).
    Moments browse like a location's photos — a thumbnail strip over the shared
    photo-gallery lightbox. Replaced wholesale by moments/update, so uploads,
    publishes and deletes land without a reload. %>
<% can_add = local_assigns.fetch(:can_add) { logged_in? }
   own = moments.to_a.select(&:displayable?).sort_by { |moment| [ moment.visibility_private_moment? ? 0 : 1, -moment.created_at.to_i ] }
   others = public_moments.select(&:displayable?).reject { |shared| logged_in? && shared.user_id == current_user.id }
   shown = own + others %>

<div data-controller="photo-gallery" data-photo-gallery-index-value="0">
  <div class="flex items-center justify-between gap-2">
    <h3 class="text-base font-semibold text-gray-900 dark:text-white">
      <%= t("plans.start.shared_moments") %>
      <span class="ml-1 text-sm font-normal text-gray-500 dark:text-gray-400">(<%= shown.size %>)</span>
    </h3>
  </div>

  <div class="mt-3 flex gap-3 overflow-x-auto pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    <% if can_add %>
      <div class="shrink-0" data-action="submit->photo-gallery#closeLightbox">
        <%= render "plans/moment_instant_form", plan: plan, location: location, context: context, compact: true %>
      </div>
    <% end %>

    <% shown.each_with_index do |moment, index| %>
      <% mine = logged_in? && moment.user_id == current_user.id
         thumb = mine ? photo_plan_moment_path(moment.plan, moment, size: "thumb") : url_for(moment.photo.variant(resize_to_fill: [ 200, 200 ]))
         full = mine ? photo_plan_moment_path(moment.plan, moment, size: "story") : url_for(moment.photo.variant(resize_to_limit: [ 1080, 1080 ])) %>
      <div class="w-24 shrink-0 text-center">
        <button type="button"
                data-action="click->photo-gallery#openLightbox"
                data-index="<%= index %>"
                data-photo-gallery-target="thumbnail"
                data-photo-gallery-full-url="<%= full %>"
                class="relative block size-24 overflow-hidden rounded-full ring-2 ring-offset-2 ring-transparent dark:ring-offset-gray-800"
                aria-label="<%= t("plans.start.shared_moments") %> <%= index + 1 %>">
          <%= image_tag thumb, class: "size-full object-cover", loading: "lazy", alt: "" %>
        </button>

        <% if mine %>
          <p class="mt-2 truncate text-[10px] font-semibold <%= moment.visibility_private_moment? ? "text-yellow-600 dark:text-yellow-400" : (moment.approved? ? "text-emerald-600 dark:text-emerald-400" : "text-orange-600 dark:text-orange-400") %>">
            <%= moment.visibility_private_moment? ? t("plans.start.story_private") : (moment.approved? ? t("plans.start.story_public") : t("plans.start.story_pending")) %>
          </p>

          <div class="mt-1 flex items-center justify-center gap-1">
            <% if moment.visibility_private_moment? %>
              <%= button_to t("plans.start.story_publish"), publish_plan_moment_path(moment.plan, moment),
                    method: :patch,
                    params: { context: context }.compact,
                    class: "rounded-full bg-gray-900/90 px-2 py-0.5 text-[10px] font-semibold text-white dark:bg-white/90 dark:text-gray-900" %>
            <% end %>
            <%= button_to t("plans.start.story_delete"), plan_moment_path(moment.plan, moment),
                  method: :delete,
                  params: { context: context }.compact,
                  form: { data: { turbo_confirm: t("plans.start.story_delete_confirm") } },
                  class: "rounded-full bg-red-600/90 px-2 py-0.5 text-[10px] font-semibold text-white" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if shown.empty? %>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("plans.start.story_none") %></p>
    <% if logged_in? %>
      <p class="mt-1 text-xs text-gray-400 dark:text-gray-500"><%= t("plans.start.story_upload_note") %></p>
    <% end %>
  <% end %>

  <%= render "shared/photo_lightbox", count: shown.size if shown.any? %>
</div>
