<% content_for :title, "#{t('explore_bosnia.title')} — #{t("explore_bosnia.tiles.#{@tile_key}")}" %>

<% content_for :head do %>
  <%= stylesheet_link_tag "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css", "data-turbo-track": "reload" %>
<% end %>

<%# Navigation %>
<%= render "new_design/header" %>

<%# The reel owns everything below the fixed header: no page scroll, no
    scrollbar, exactly one card in view. %>
<div class="fixed inset-x-0 bottom-0 top-[calc(5rem+env(safe-area-inset-top))] flex flex-col overflow-hidden pb-[env(safe-area-inset-bottom)]" data-controller="moment-lightbox">
  <div class="flex items-center gap-2 px-4 py-2">
    <%= link_to explore_bosnia_path,
          class: "inline-flex items-center gap-1 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <%= t("explore_bosnia.back") %>
    <% end %>
    <span class="text-sm font-semibold text-gray-900 dark:text-white"><%= t("explore_bosnia.tiles.#{@tile_key}") %></span>
  </div>

  <% if @needs_location %>
    <div class="mx-4 rounded-2xl border border-dashed border-gray-300 px-4 py-8 text-center dark:border-gray-600">
      <p class="text-base font-semibold text-gray-900 dark:text-white"><%= t("explore_bosnia.needs_location.title") %></p>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400"><%= t("explore_bosnia.needs_location.body") %></p>
      <%= link_to t("explore_bosnia.needs_location.retry"), explore_bosnia_path,
            class: "mt-4 inline-flex rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow" %>
    </div>
  <% elsif @locations.any? %>
    <div id="moment-flash" class="absolute inset-x-0 top-12 z-30 px-4"></div>

    <div class="flex-1 snap-y snap-mandatory overflow-y-auto overscroll-y-contain scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
         data-controller="plan-deck" data-plan-deck-browse-value="true">
      <%= render "explore_bosnia/reel_page",
            plan: @plan, locations: @locations, page: @page, has_more: @has_more,
            tile_key: @tile_key, lat: @lat, lng: @lng %>

      <button type="button" data-plan-deck-target="reelHint" data-action="plan-deck#dismissReelHint"
              class="hidden fixed bottom-6 left-1/2 z-30 -translate-x-1/2 flex-col items-center gap-0.5 rounded-full bg-sky-400/85 px-4 py-2 text-center text-xs font-semibold text-white shadow-lg animate-bounce">
        <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
        <%= t("explore_bosnia.reel_hint") %>
      </button>
    </div>
  <% else %>
    <p class="mx-4 rounded-2xl border border-dashed border-gray-300 dark:border-gray-600 px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
      <%= @all_visited ? t("explore_bosnia.deck_all_visited") : t("explore_bosnia.deck_empty") %>
    </p>
  <% end %>

  <div data-moment-lightbox-target="overlay"
       data-action="click->moment-lightbox#closeOnBackground"
       class="hidden fixed inset-0 z-[70] flex items-center justify-center bg-black/80 p-4">
    <button type="button" data-action="moment-lightbox#close"
            class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20"
            aria-label="<%= t('common.close') %>">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img data-moment-lightbox-target="image" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain shadow-2xl">
  </div>
</div>
