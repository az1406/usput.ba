<%# Locals: plan, locations, page, has_more, tile_key, lat, lng.
    display:contents so the frame wrapper doesn't sit between the scroll
    container and its snap slots. %>
<%= turbo_frame_tag "explore_page_#{page}", class: "contents" do %>
  <% locations.each do |location| %>
    <div class="flex h-full snap-start items-center justify-center px-3 py-2">
      <%# Width derived from the slot height at 2:3, clamped to the screen —
          the card always fits and always centers, portrait or landscape. %>
      <div class="w-[min(100%,calc((100dvh-10rem)*0.62))]">
        <%= render "plans/walk_card",
              plan: plan,
              location: location,
              visited: false,
              distance_km: (location.respond_to?(:distance) ? location.distance : nil),
              context: "explore" %>
      </div>
    </div>
  <% end %>

  <% if has_more %>
    <%= turbo_frame_tag "explore_page_#{page + 1}",
          src: explore_bosnia_experience_path(tile_key, lat: lat, lng: lng, page: page + 1),
          loading: "lazy",
          class: "contents" do %>
      <div class="flex h-full snap-start items-center justify-center">
        <span class="size-10 animate-spin rounded-full border-4 border-white/30 border-t-white"></span>
      </div>
    <% end %>
  <% else %>
    <div class="flex h-full snap-start items-center justify-center px-6">
      <p class="text-center text-sm text-gray-500 dark:text-gray-400"><%= t("explore_bosnia.deck_end") %></p>
    </div>
  <% end %>
<% end %>
