<% content_for :title do %><%= t("events.index.title") %> - Usput.ba<% end %>
<% content_for :meta_description do %><%= t("events.index.subtitle") %><% end %>

<div class="bg-white dark:bg-gray-900 min-h-screen overflow-x-hidden">
  <%= render "new_design/header" %>

  <main>
    <%# Hero/Filter Section %>
    <div class="relative isolate pt-14">
      <svg aria-hidden="true" class="absolute inset-x-0 top-0 -z-10 h-[64rem] w-full [mask-image:radial-gradient(32rem_32rem_at_center,white,transparent)] stroke-gray-200 dark:stroke-white/10">
        <defs>
          <pattern id="events-hero-pattern" width="200" height="200" x="50%" y="-1" patternUnits="userSpaceOnUse">
            <path d="M.5 200V.5H200" fill="none" />
          </pattern>
        </defs>
        <svg x="50%" y="-1" class="overflow-visible fill-gray-50 dark:fill-gray-800">
          <path d="M-200 0h201v201h-201Z M600 0h201v201h-201Z M-400 600h201v201h-201Z M200 800h201v201h-201Z" stroke-width="0" />
        </svg>
        <rect width="100%" height="100%" fill="url(#events-hero-pattern)" stroke-width="0" />
      </svg>
      <div aria-hidden="true" class="absolute top-0 right-0 left-1/2 -z-10 -ml-24 transform-gpu overflow-hidden blur-3xl lg:ml-24 xl:ml-48">
        <div style="clip-path: polygon(63.1% 29.5%, 100% 17.1%, 76.6% 3%, 48.4% 0%, 44.6% 4.7%, 54.5% 25.3%, 59.8% 49%, 55.2% 57.8%, 44.4% 57.2%, 27.8% 47.9%, 35.1% 81.5%, 0% 97.7%, 39.2% 100%, 35.2% 81.4%, 97.2% 52.8%, 63.1% 29.5%); aspect-ratio: 801/1036;" class="w-[50rem] bg-gradient-to-tr from-rose-400/30 to-orange-400/30 dark:from-rose-600/20 dark:to-orange-500/20 opacity-70"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h1 class="text-4xl font-semibold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
            <%= t("events.index.title") %>
          </h1>
          <p class="mt-6 text-lg/8 text-gray-600 dark:text-gray-300">
            <%= t("events.index.subtitle") %>
          </p>
        </div>

        <% if @cities.any? %>
          <div class="mt-10 flex flex-wrap justify-center gap-2">
            <%= link_to t("events.all_cities"), events_path,
                class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:city].blank? ? 'bg-rose-600 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'}" %>
            <% @cities.each do |city| %>
              <%= link_to city, events_path(city: city),
                  class: "px-3 py-1.5 rounded-full text-sm font-medium #{params[:city] == city ? 'bg-rose-600 text-white' : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700'}" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# Results Section %>
    <div class="relative z-10 mx-auto max-w-7xl px-6 pb-24 lg:px-8">
      <% if @upcoming_events.any? || @past_events.any? %>
        <% if @upcoming_events.any? %>
          <div class="mb-12">
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6 flex items-center">
              <svg class="w-6 h-6 mr-2 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
              </svg>
              <%= t("events.index.upcoming_heading") %>
              <span class="ml-2 text-sm font-normal text-gray-500 dark:text-gray-400">(<%= @upcoming_events.size %>)</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% @upcoming_events.each do |event| %>
                <%= render "events/event_card", event: event %>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @past_events.any? %>
          <div class="mb-12">
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6 flex items-center">
              <svg class="w-6 h-6 mr-2 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <%= t("events.index.past_heading") %>
              <span class="ml-2 text-sm font-normal text-gray-500 dark:text-gray-400">(<%= @past_events.size %>)</span>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              <% @past_events.each do |event| %>
                <%= render "events/event_card", event: event %>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="text-center py-16">
          <svg class="mx-auto h-16 w-16 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-white">
            <%= t("events.index.upcoming_heading") %>
          </h3>
          <p class="mt-2 text-gray-600 dark:text-gray-400">
            <%= t("events.index.no_upcoming") %>
          </p>
        </div>
      <% end %>
    </div>

    <%= render "new_design/footer" %>
  </main>
</div>
