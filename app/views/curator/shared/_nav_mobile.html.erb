<%# The mobile menu: one flat section per group from curator_nav_groups. Same
    routes as the desktop bar, different interaction model. %>
<div class="px-2 pb-3 pt-2">
  <%= link_to t("curator.nav.dashboard"), curator_root_path,
      class: "block rounded-md px-3 py-2 text-base font-medium #{request.path == curator_root_path ? 'bg-emerald-800 dark:bg-gray-900 text-white' : 'text-emerald-100 dark:text-gray-300 hover:bg-emerald-600 dark:hover:bg-gray-700'}" %>

  <% curator_nav_groups.each do |group| %>
    <div class="mt-3">
      <p class="px-3 text-xs font-semibold uppercase tracking-wider <%= group[:admin] ? "text-red-300 dark:text-red-400" : "text-emerald-300 dark:text-gray-500" %>">
        <%= curator_nav_label(group) %>
      </p>
      <% group[:items].each do |item| %>
        <% current = request.path.start_with?(item[:path])
           active = group[:admin] ? "bg-red-800 dark:bg-red-900 text-white" : "bg-emerald-800 dark:bg-gray-900 text-white"
           idle = group[:admin] ? "text-red-200 dark:text-red-300 hover:bg-red-600 dark:hover:bg-red-800" : "text-emerald-100 dark:text-gray-300 hover:bg-emerald-600 dark:hover:bg-gray-700" %>
        <%= link_to curator_nav_label(item), item[:path],
            class: "block rounded-md px-3 py-2 text-base font-medium #{current ? active : idle}" %>
      <% end %>
    </div>
  <% end %>
</div>
