<div class="rounded-lg bg-white dark:bg-gray-800 shadow p-4">
  <div class="flex items-start justify-between">
    <div class="flex-1">
      <div class="flex items-center gap-2 mb-2">
        <div class="flex items-center">
          <% review.rating.times do %>
            <svg class="h-4 w-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          <% end %>
          <% (5 - review.rating).times do %>
            <svg class="h-4 w-4 text-gray-300 dark:text-gray-600" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          <% end %>
        </div>
        <span class="inline-flex items-center rounded-full bg-gray-100 dark:bg-gray-700 px-2 py-0.5 text-xs font-medium text-gray-800 dark:text-gray-300">
          <%= review.reviewable_type %>
        </span>
        <% if deleted %>
          <span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900/40 px-2 py-0.5 text-xs font-medium text-red-800 dark:text-red-300">
            <%= t("curator.reviews.deleted_by.#{review.source}", name: review.deleted_by&.username) %>
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium <%= review.moderation_classes %>">
            <% if review.flagged? %>
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            <% end %>
            <%= t("curator.reviews.status.#{review.moderation_status}") %>
          </span>
        <% end %>
      </div>
      <p class="text-sm text-gray-600 dark:text-gray-400 mb-2"><%= review.comment.presence || t("curator.reviews.no_comment") %></p>
      <% if deleted && review.reason.present? %>
        <p class="text-xs italic text-gray-500 dark:text-gray-400 mb-2"><%= review.reason %></p>
      <% elsif !deleted && review.moderation_note_key %>
        <p class="text-xs italic text-amber-700 dark:text-amber-400 mb-2">
          <% if review.moderation_category.present? %>
            <%= t("curator.reviews.#{review.moderation_note_key}", category: t("curator.reviews.category.#{review.moderation_category}", default: review.moderation_category)) %>
            <%= "(#{(review.moderation_confidence * 100).round}%)" if review.moderation_confidence %>
            <%= "— #{review.moderation_reason}" if review.moderation_reason.present? %>
          <% else %>
            <%= t("curator.reviews.unchecked") %>
          <% end %>
        </p>
      <% end %>
      <div class="text-xs text-gray-500 dark:text-gray-400">
        <span><%= review.author_name.presence || review.user&.username || t("reviews.anonymous") %></span>
        <span class="mx-1">&middot;</span>
        <span><%= review.created_at.strftime("%d.%m.%Y %H:%M") %></span>
        <span class="mx-1">&middot;</span>
        <% if review.reviewable %>
          <span><%= review.reviewable.try(:name) || review.reviewable.try(:title) %></span>
        <% else %>
          <span class="text-red-500 dark:text-red-400"><%= t("curator.reviews.deleted_item") %></span>
        <% end %>
      </div>
    </div>
    <% unless deleted %>
      <div class="flex items-center gap-2 ml-4">
        <% unless review.approved? %>
          <%= button_to approve_curator_review_path(review),
              method: :post,
              class: "text-emerald-600 dark:text-emerald-400 hover:text-emerald-900 dark:hover:text-emerald-300 text-sm" do %>
            <%= t("curator.reviews.approve") %>
          <% end %>
        <% end %>
        <% unless review.rejected? %>
          <%= button_to reject_curator_review_path(review),
              method: :post,
              class: "text-amber-600 dark:text-amber-400 hover:text-amber-900 dark:hover:text-amber-300 text-sm" do %>
            <%= t("curator.reviews.reject") %>
          <% end %>
        <% end %>
        <%= link_to curator_review_path(review), class: "text-emerald-600 dark:text-emerald-400 hover:text-emerald-900 dark:hover:text-emerald-300 text-sm" do %>
          <%= t("common.view_all") %>
        <% end %>
        <%= button_to curator_review_path(review),
            method: :delete,
            class: "text-red-600 dark:text-red-400 hover:text-red-900 dark:hover:text-red-300 text-sm",
            data: { turbo_confirm: t("curator.reviews.confirm_delete") } do %>
          <%= t("common.delete") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
