<div class="space-y-4 sm:space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 sm:gap-0">
    <h1 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-white"><%= t("curator.reviews.title") %></h1>
  </div>

  <!-- Pending Proposals -->
  <%= render "curator/shared/pending_proposals", pending_proposals: @pending_proposals %>

  <!-- Stats Overview -->
  <div class="grid grid-cols-2 gap-3 sm:gap-5 sm:grid-cols-4">
    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 px-4 py-4 shadow">
      <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("curator.reviews.total") %></dt>
      <dd class="mt-1 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white"><%= @stats[:total] %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 px-4 py-4 shadow">
      <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("curator.reviews.average_rating") %></dt>
      <dd class="mt-1 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white"><%= @stats[:average_rating] %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 px-4 py-4 shadow">
      <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("curator.reviews.with_comments") %></dt>
      <dd class="mt-1 text-2xl font-semibold tracking-tight text-gray-900 dark:text-white"><%= @stats[:with_comments] %></dd>
    </div>
    <div class="overflow-hidden rounded-lg bg-white dark:bg-gray-800 px-4 py-4 shadow">
      <dt class="truncate text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("curator.reviews.by_type") %></dt>
      <dd class="mt-1 text-sm text-gray-900 dark:text-white">
        <% @stats[:by_type].each do |type, count| %>
          <span class="block"><%= type %>: <%= count %></span>
        <% end %>
      </dd>
    </div>
  </div>

  <!-- Filters -->
  <div class="rounded-lg bg-white dark:bg-gray-800 shadow px-4 py-4 overflow-visible">
    <%= form_with url: curator_reviews_path, method: :get, class: "flex flex-col sm:flex-row flex-wrap gap-3" do |f| %>
      <div class="flex-1 min-w-0 sm:max-w-xs">
        <%= f.text_field :search,
            value: params[:search],
            placeholder: t("curator.reviews.search_placeholder"),
            class: "block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
      </div>
      <div class="w-full sm:w-auto">
        <%= f.select :type,
            options_for_select([
              [t("curator.reviews.all_types"), ""],
              ["Location", "Location"],
              ["Experience", "Experience"],
              ["Plan", "Plan"]
            ], params[:type]),
            {},
            class: "block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
      </div>
      <div class="w-full sm:w-auto">
        <%= f.select :rating,
            options_for_select([
              [t("curator.reviews.all_ratings"), ""],
              ["5", "5"],
              ["4", "4"],
              ["3", "3"],
              ["2", "2"],
              ["1", "1"]
            ], params[:rating]),
            {},
            class: "block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
      </div>
      <div class="w-full sm:w-auto">
        <%= f.select :status,
            options_for_select([
              [t("curator.reviews.any_status"), ""],
              [t("curator.reviews.status.pending"), "pending"],
              [t("curator.reviews.status.approved"), "approved"],
              [t("curator.reviews.status.rejected"), "rejected"]
            ], params[:status]),
            {},
            class: "block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
      </div>
      <div class="w-full sm:w-auto">
        <%= f.select :deleted,
            options_for_select([
              [t("curator.reviews.all_reviews"), ""],
              [t("curator.reviews.only_deleted"), "1"]
            ], params[:deleted]),
            {},
            class: "block w-full rounded-md border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-200 text-sm shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
      </div>
      <div class="w-full sm:w-auto">
        <%= f.submit t("common.search"), class: "w-full sm:w-auto inline-flex justify-center items-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-emerald-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Reviews List -->
  <div class="space-y-4">
    <%= render partial: "curator/reviews/review_item", collection: @reviews, as: :review, locals: { deleted: params[:deleted].present? } %>

    <% if @reviews.empty? %>
      <div class="rounded-lg bg-white dark:bg-gray-800 shadow p-8 text-center text-gray-500 dark:text-gray-400">
        <%= t("curator.reviews.no_reviews") %>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @reviews.total_pages > 1 %>
    <div class="flex justify-center">
      <%= paginate @reviews %>
    </div>
  <% end %>
</div>
